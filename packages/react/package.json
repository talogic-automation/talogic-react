{
  "name": "@talogic-automation/react",
  "version": "0.1.0",
  "description": "Talogic design system: tokens, shadcn/ui primitives and surface patterns for web, app, desktop and mobile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts.css": "./src/tokens/fonts.css",
    "./styles.css": "./dist/talogic-react.css"
  },
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "src/tokens/fonts.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && npm run build:css",
    "build:css": "tailwindcss -i src/tokens/styles.css -o dist/talogic-react.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --cache",
    "format": "eslint . --fix --cache",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.82.0",
    "radix-ui": "^1.8.1",
    "react-resizable-panels": "^4.24.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@storybook/react-vite": "^10.6.9",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.3.5",
    "vite": "^8.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talogic-automation/talogic-react.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
